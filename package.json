{
  "name": "headless-multitenant-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Decoupled headless multi-tenant multi-brand retail & wholesale e-commerce platform powered by Medusa v2 and Next.js",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:isolation": "pnpm --filter medusa test:isolation",
    "brand:create": "node scripts/brand-cli.mjs create",
    "brand:validate": "node scripts/brand-cli.mjs validate",
    "ci:guard": "node scripts/ci-guard-protected-zones.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.5.2",
    "tsx": "^4.23.15",
    "turbo": "^2.11.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "zod": "^3.24.2"
  },
  "packageManager": "pnpm@12.6.0"
}
