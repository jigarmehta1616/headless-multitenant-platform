    "@medusajs/framework": "2.21.2",
    "@medusajs/locking-redis": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/types": "2.21.2",
    "@medusajs/utils": "2.21.2",
    "@medusajs/workflow-engine-redis": "2.21.2",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@platform/config": "workspace:*",
